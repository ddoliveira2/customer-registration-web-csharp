@{
    ViewData["Title"] = "Login Page";
    Layout = "_Layout";
}

@model List<Customer>

<link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />

 <section class="content">
    <div class="search-card">
        <h3>Pesquisar clientes</h3>
        <form class="search-form" asp-action="Index" asp-controller="Customer">
            <div class="form-group">
                <label for="nome">Nome do cliente</label>
                <input name="name" type="text" id="nome" placeholder="Digite o nome do cliente...">
            </div>
            <button type="submit" class="btn btn-primary">🔍 Pesquisar</button>
        </form>
    </div>
    <div class="grid-card">
        <div class="grid-header">
            <div>
                <h3>Lista de clientes</h3>
                <span>Clientes encontrados: <strong id="total">5</strong></span>
            </div>
            <button class="btn btn-success" onclick="novoCliente()">+ Novo cliente</button>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nome</th>
                        <th>RG</th>
                        <th>CPF</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="listaClientes">
                    @if (Model.Count  > 0)
                    {
                        @foreach (Customer item in Model)
                        {
                            <tr>
                                <td>@item.id</td>
                                <td>@item.name</td>
                                <td>@item.rg</td>
                                <td>@item.cpf</td>
                                <td><span class="status active-status">Ativo</span></td>
                                <td>
                                    <div class="actions">
                                        <button class="btn-action btn-edit" onclick="editarCliente(@item.id)">Editar</button>
                                        <button class="btn-action btn-delete" onclick="excluirCliente(@item.id)">Excluir</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                                                                 
                </tbody>
            </table>  
        </div>
        <div class="pagination">
            <span>Exibindo 1 a 5 de 5 registros</span>
            <div class="pagination-buttons">
                <button disabled>‹</button>
                <button class="active">1</button>
                <button disabled>›</button>
            </div>
        </div>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/customer.js" asp-append-version="true"></script>