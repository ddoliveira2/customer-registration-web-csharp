@{
    ViewData["Title"] = "Login Page";
    Layout = "_Layout";
}
@model Customer;

<link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />

<section class="content">
    <div class="page-title">
        <h1>Cadastro de clientes</h1>
        <p>Preencha os campos abaixo para cadastrar ou atualizar um cliente.</p>
    </div>    
    <div class="form-card">
        <h3>Dados do cliente</h3>
        <form id="formCliente" asp-action="Salvar" asp-controller="Customer" method="post">
            <div class="form-grid">
                <div class="form-group">
                    <label for="codigo">Código</label>
                    <input type="text" id="codigo" name="codigo" placeholder="Automático" value="@(Model.id == 0 ? "" : Model.id.ToString())">
                </div>
                <div class="form-group">
                    <label id="lbStatus" for="status">Status</label>
                    <select id="status" name="status">
                        <option value="true">Ativo</option>
                        <option value="false">Inativo</option>
                    </select>
                </div>
                <div class="form-group full-width">
                    <label for="nome">Nome</label>
                    <input type="text" id="nome" name="nome"  placeholder="Digite o nome completo" maxlength="150" value="@Model.name" required>
                </div>
                <div class="form-group">
                    <label for="rg">RG</label>
                    <input type="text" id="rg" name="rg" placeholder="Digite o RG" maxlength="20" value="@Model.rg" required>
                </div>
                <div class="form-group">
                    <label for="cpf">CPF</label>
                    <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" maxlength="14" value="@Model.cpf" required>
                </div>
            </div>
            <div class="form-buttons">
                <button type="button" class="btn btn-back" onclick="voltar()">← Voltar</button>
                <button type="reset" class="btn btn-secondary">Limpar</button>
                <button type="submit" class="btn btn-primary">✓ Salvar</button>
            </div>
        </form>
    </div>
</section>

<script src="~/js/customer.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@if (TempData["Mensagem"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                title: 'Sucesso!',
                text: '@TempData["Mensagem"]',
                icon: '@TempData["TipoMensagem"]',
                confirmButtonText: 'OK'
            }).then((result) => {

                if (result.isConfirmed) {
                    window.location.href = '/Customer/Index';
                }

            });
           

        });
    </script>
}