@{
    ViewData["Title"] = "Login Page";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />

<section class="content">
    <div class="page-title">
        <h1>Cadastro de clientes</h1>
        <p>Preencha os campos abaixo para cadastrar ou atualizar um cliente.</p>
    </div>    
    <div class="form-card">
        <h3>Dados do cliente</h3>
        <form id="formCliente" onsubmit="salvar(event)">
            <div class="form-grid">
                <div class="form-group">
                    <label for="codigo">Código</label>
                    <input type="text" id="codigo" placeholder="Automático" disabled>
                </div>
                <div class="form-group">
                    <label id="lbStatus" for="status">Status</label>
                    <select id="status">
                        <option value="true">Ativo</option>
                        <option value="false">Inativo</option>
                    </select>
                </div>
                <div class="form-group full-width">
                    <label for="nome">Nome</label>
                    <input type="text" id="nome" placeholder="Digite o nome completo" maxlength="150" required>
                </div>
                <div class="form-group">
                    <label for="rg">RG</label>
                    <input type="text" id="rg" placeholder="Digite o RG" maxlength="20"required>
                </div>
                <div class="form-group">
                    <label for="cpf">CPF</label>
                    <input type="text" id="cpf" placeholder="000.000.000-00" maxlength="14" required>
                </div>
            </div>
            <div class="form-buttons">
                <button type="button" class="btn btn-back" onclick="voltar()">← Voltar</button>
                <button type="reset" class="btn btn-secondary">Limpar</button>
                <button type="submit" class="btn btn-primary">✓ Salvar</button>
            </div>
        </form>
    </div>
</section>

<script src="~/js/customer.js" asp-append-version="true"></script>
